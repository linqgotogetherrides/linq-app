{
  "installCommand": "cd frontend && npm install",
  "buildCommand": "cd frontend && npx expo export -p web",
  "outputDirectory": "frontend/dist",
  "devCommand": "cd frontend && npx expo",
  "cleanUrls": true,
  "framework": null,
  "rewrites": [
    {
      "source": "/:path*",
      "destination": "/"
    }
  ]
}
